<xml xmlns:cbg="https://codebridge.app/xml" cbg:format="1" cbg:app="0.2.0" xmlns="https://developers.google.com/blockly/xml">
  <block type="initializes_setup" id="blink-setup" x="250" y="30">
    <comment pinned="true" h="87" w="242" x="-18" y="5">把 13 腳設定為輸出</comment>
    <statement name="CONTENT">
      <block type="arduino_pin_mode" id="blink-pinmode">
        <field name="MODE">OUTPUT</field>
        <value name="PIN">
          <shadow type="arduino_pin_shadow" id="blink-pin-shadow">
            <field name="PIN">13</field>
          </shadow>
        </value>
      </block>
    </statement>
    <next>
      <block type="initializes_loop" id="blink-loop">
        <comment pinned="true" h="120" w="245" x="-19" y="103">亮 500ms → 暗 500ms </comment>
        <statement name="CONTENT">
          <block type="arduino_digital_write" id="blink-on">
            <field name="VALUE">HIGH</field>
            <value name="PIN">
              <shadow type="arduino_pin_shadow" id="blink-on-pin">
                <field name="PIN">13</field>
              </shadow>
            </value>
            <next>
              <block type="arduino_delay" id="Ja#x]8Miuv6ODFq|ivWs">
                <value name="TIME">
                  <shadow type="math_number" id="dtYeg5KO)dL,4s=PX/NF">
                    <field name="NUM">500</field>
                  </shadow>
                </value>
                <next>
                  <block type="arduino_digital_write" id="4=Xl:if0j,EPA7-ZV1G2">
                    <field name="VALUE">LOW</field>
                    <value name="PIN">
                      <shadow type="arduino_pin_shadow" id="~Wc9}30N{y06Md;.*hZu">
                        <field name="PIN">13</field>
                      </shadow>
                    </value>
                    <next>
                      <block type="arduino_delay" id="#):1r^e27fsS1ICuu+;s">
                        <value name="TIME">
                          <shadow type="math_number" id="B,(dHYZA]OZ|E1oxf9,!">
                            <field name="NUM">500</field>
                          </shadow>
                        </value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </next>
  </block>
</xml>
