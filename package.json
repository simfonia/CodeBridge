{
  "name": "codebridge",
  "displayName": "CodeBridge: Visual Arduino Programming",
  "description": "Tauri desktop IDE for visual Arduino programming with Blockly",
  "version": "0.2.0",
  "icon": "resources/app_icon.png",
  "publisher": "simfonia",
  "engines": {
    "tauri": ">=2.0.0"
  },
  "scripts": {
    "dev": "npm run dev --prefix ui",
    "build": "npm run build --prefix ui",
    "test": "npm run test --prefix ui",
    "test:unit": "npm run test:unit --prefix ui",
    "test:unit:fast": "npm run test:unit:fast --prefix ui",
    "test:e2e": "npm run test:e2e --prefix ui",
    "test:e2e:smoke": "npm run test:e2e:smoke --prefix ui",
    "test:fast": "node scripts/test-related.mjs",
    "cargo:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri"
  }
}