# ============================================================
# EditorConfig：行尾與編碼的編輯器層權威（2026-10-03 新增）
# ============================================================
# 為什麼需要這份檔案（.gitattributes 不足之處）：
#   .gitattributes 的 `text` 只在「經過 git 的路徑」（checkout / add / diff）生效。
#   但編輯器、Python 腳本、PowerShell 直接寫檔時**不經過 git**，
#   工作區就會變成 LF —— 而 git 會把「工作區 LF + 轉換後 LF」視為無差異，
#   **問題不會自己浮現**，會靜態累積。
#   實測 2026-10-03：214 個受追蹤檔中 24 個工作區是 LF、**6 個混合行尾**。
#
#   EditorConfig 由編輯器在「存檔當下」強制，不需經過 git。
#   驗證／補救工具：npm run eol:check / eol:fix（scripts/eol.mjs）
#
# 分工：
#   .editorconfig → 預防（編輯器存檔時就寫對）
#   .gitattributes → 保險（git 取出時轉換）
#   scripts/eol.mjs → 驗證與補救（含自我交叉驗證）
# ============================================================

root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# ---------------------------------------------------------
# Markdown：不做行尾以外的格式強制
# （Markdown 慣用 trailing two-space 換行，trim 會破壞排版）
# ---------------------------------------------------------
[*.md]
trim_trailing_whitespace = false

# ---------------------------------------------------------
# 次要檔案類型
# ---------------------------------------------------------
[*.{js,mjs,cjs,ts,json,yml,yaml}]
indent_size = 2

[*.{py,rs}]
indent_size = 4

# ===========================================================
# 例外 1：.cbg 專案檔「必須是 LF」（SPEC.md §3 格式規格）
# ===========================================================
# 格式規格必須被工具保護，不能因編輯器或行尾統一而違反。
# 存檔時若被轉成 CRLF，會違反 SPEC.md §3 的格式定義。
[*.cbg]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = false

# ===========================================================
# 例外 2：位元組鎖定／工具產生的資產 —— 完全不碰行尾
# ===========================================================
# 這些檔案一被行尾轉換就會出問題（雜訊或 hash 驗證失敗），
# 與 .gitattributes 的 -text 對應，編輯器層也要一致。
# 依 .gitattributes 規則「後者勝出」，此區塊必須放在最後。

# Blockly 官方 UMD 資產：VERSIONS.md 以 bytes/SHA-256 鎖定每一個檔案
# （ui/tests/unit/blockly-assets.test.js 逐一驗證）。行尾一變 hash 必不符。
[ui/public/blockly/**]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_size = unset

# Tauri CLI 產生的平台圖示（tauri icon 會重新產生）
[src-tauri/icons/**]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

# vendored 壓縮資產
[ui/src/highlight.min.js]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[ui/src/python.min.js]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

# ===========================================================
# 例外 3：自動產物與歷史備份（不由本專案維護）
# ===========================================================
[out/**]
end_of_line = unset

[ui/dist/**]
end_of_line = unset

[src-tauri/target/**]
end_of_line = unset

[src-tauri/gen/**]
end_of_line = unset

[backup/**]
end_of_line = unset

[temp/**]
end_of_line = unset

[temp_scripts/**]
end_of_line = unset

[log/**]
trim_trailing_whitespace = false