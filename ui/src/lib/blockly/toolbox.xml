<xml>
<category name="Arduino 基本" colour="180">
    <block type="arduino_pin_mode">
        <value name="PIN">
            <shadow type="arduino_pin_shadow">
                <field name="PIN">13</field>
            </shadow>
        </value>
    </block>
    <block type="arduino_digital_write">
        <value name="PIN">
            <shadow type="arduino_pin_shadow">
                <field name="PIN">13</field>
            </shadow>
        </value>
    </block>
    <block type="arduino_digital_read">
        <value name="PIN">
            <shadow type="arduino_pin_shadow">
                <field name="PIN">13</field>
            </shadow>
        </value>
    </block>
    <block type="arduino_analog_write">
        <value name="PIN">
            <shadow type="arduino_pin_shadow">
                <field name="PIN">9</field>
            </shadow>
        </value>
        <value name="VALUE">
            <shadow type="math_number">
                <field name="NUM">128</field>
            </shadow>
        </value>
    </block>
    <block type="arduino_analog_read">
        <value name="PIN">
            <shadow type="arduino_pin_shadow">
                <field name="PIN">A0</field>
            </shadow>
        </value>
    </block>
    <block type="arduino_delay">
        <value name="TIME">
            <shadow type="math_number">
                <field name="NUM">1000</field>
            </shadow>
        </value>
    </block>
    <block type="arduino_serial_print">
        <value name="VALUE">
            <shadow type="text">
                <field name="TEXT">Hello</field>
            </shadow>
        </value>
    </block>
</category>
<category name="控制流程" colour="210">
    <block type="controls_if"></block>
    <block type="controls_repeat_ext">
        <value name="TIMES">
            <shadow type="math_number">
                <field name="NUM">10</field>
            </shadow>
        </value>
    </block>
    <block type="controls_whileUntil">
        <value name="BOOL">
            <block type="logic_boolean">
                <field name="BOOL">TRUE</field>
            </block>
        </value>
    </block>
    <block type="controls_for">
        <value name="FROM">
            <shadow type="math_number">
                <field name="NUM">1</field>
            </shadow>
        </value>
        <value name="TO">
            <shadow type="math_number">
                <field name="NUM">10</field>
            </shadow>
        </value>
        <value name="BY">
            <shadow type="math_number">
                <field name="NUM">1</field>
            </shadow>
        </value>
    </block>
</category>
<category name="邏輯" colour="210">
    <block type="logic_compare"></block>
    <block type="logic_operation"></block>
    <block type="logic_negate"></block>
    <block type="logic_boolean"></block>
    <block type="logic_null"></block>
</category>
<category name="數學" colour="230">
    <block type="math_number"></block>
    <block type="math_arithmetic"></block>
    <block type="math_single"></block>
    <block type="math_trig"></block>
    <block type="math_map">
        <value name="VALUE">
            <shadow type="math_number">
                <field name="NUM">0</field>
            </shadow>
        </value>
        <value name="FRMIN">
            <shadow type="math_number">
                <field name="NUM">1</field>
            </shadow>
        </value>
        <value name="FRMAX">
            <shadow type="math_number">
                <field name="NUM">100</field>
            </shadow>
        </value>
        <value name="TO_MIN">
            <shadow type="math_number">
                <field name="NUM">0</field>
            </shadow>
        </value>
        <value name="TO_MAX">
            <shadow type="math_number">
                <field name="NUM">255</field>
            </shadow>
        </value>
    </block>
</category>
<category name="變數" colour="330">
    <block type="variables_set"></block>
    <block type="variables_get"></block>
</category>
</xml>