<xml xmlns:cbp="https://codebridge.app/xml" cbp:format="1" cbp:name="serial-hello" xmlns="https://developers.google.com/blockly/xml"><block type="initializes_setup" id="hello-setup" x="230" y="30"><comment pinned="true" h="86" w="173" x="22" y="-2">以 9600 啟用序列埠</comment><statement name="CONTENT"><block type="arduino_serial_begin" id="hello-begin"><field name="BAUD">9600</field></block></statement><next><block type="initializes_loop" id="hello-loop"><comment pinned="true" h="89" w="172" x="23" y="102">每秒輸出一行問候</comment><statement name="CONTENT"><block type="arduino_serial_println" id="hello-print"><value name="VALUE"><block type="text" id="hello-text"><field name="TEXT">Hello, CodeBridge!</field></block></value><next><block type="arduino_delay" id="vIdbSI.a%IN{SINRiI-V"><value name="TIME"><shadow type="math_number" id="C^P:I*LR|Saop+R[$:5b"><field name="NUM">1000</field></shadow></value></block></next></block></statement></block></next></block></xml>